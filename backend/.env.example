
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL connection: database/schema.sql creates `expensio`
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_MYSQL_PASSWORD
DB_NAME=expensio

# Use a unique, cryptographically random secret (32+ bytes) in real deployments
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET


SEED_EMPLOYEE_PASSWORD=REPLACE_WITH_UNIQUE_EMPLOYEE_PASSWORD
SEED_DIRECTOR_PASSWORD=REPLACE_WITH_UNIQUE_DIRECTOR_PASSWORD
SEED_ACCOUNTS_PASSWORD=REPLACE_WITH_UNIQUE_ACCOUNTS_PASSWORD
